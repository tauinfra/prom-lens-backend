# 复制为 secret.yaml 后填入真实值，勿将 secret.yaml 提交到 Git
# cp secret.yaml.example secret.yaml
# kubectl apply -f secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: prom-lens-secret
  namespace: prom-lens
  labels:
    app.kubernetes.io/name: prom-lens-backend
type: Opaque
stringData:
  database-password: "change-me"
  jwt-secret: "change-me-at-least-16-chars"
